# Copy to .env and adjust for this computer.
# Keep credentials blank here; configure AWS credentials with aws configure or an IAM role.
# Local app settings. Keep API keys private; this file is git-ignored.
MORNORK_EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
MORNORK_EXPERTS_FILE=config/experts.json
MORNORK_THRESHOLDS_FILE=config/routing.thresholds.prototype.json
MORNORK_INTENT_RULES_FILE=config/routing.intent-rules.json
MORNORK_KNOWLEDGE_ROOT=data/knowledge
MORNORK_ROUTING_MODE=prototype
MORNORK_AUDIT_LOG=logs/routing.jsonl
MORNORK_EXPERT_AUDIT_LOG=logs/experts.audit.jsonl
MORNORK_EXPERT_MODEL_ROOT=artifacts/experts
MORNORK_HOST=127.0.0.1
MORNORK_EXPERT_DEVICE=cpu
MORNORK_EXPERT_DTYPE=bfloat16
MORNORK_EXPERT_MAX_NEW_TOKENS=
MORNORK_EMBEDDER_DEVICE=cuda
MORNORK_CHECKPOINT=artifacts/mornork-0.6b
MORNORK_GENERATION_DEVICE=cuda
MORNORK_GENERATION_DTYPE=bfloat16
MORNORK_MAX_NEW_TOKENS=
MORNORK_PORT=8765
MORNORK_NO_BROWSER=false
# Comma-separated origins allowed to call FastAPI from the separate static frontend.
MORNORK_FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Internal Experts inference endpoint in this FastAPI service.
MORNORK_EXPERT_INFERENCE_URL=http://127.0.0.1:8765/api/experts/infer
MORNORK_EXPERT_API_KEY=
MORNORK_EXPERT_BACKEND_API_KEY=
MORNORK_EXPERT_TIMEOUT_SECONDS=45
MORNORK_DATABASE=data/mornork.sqlite3
MORNORK_DATASET_ROOT=data/datasets
MORNORK_TRAINED_MODEL_ROOT=artifacts
MORNORK_TRAINING_LOG_ROOT=logs/training
MORNORK_MAX_DATASET_UPLOAD_MB=256

# Optional versioned model artifact storage
MORNORK_ARTIFACT_STORAGE=s3
MORNORK_S3_BUCKET=mornork-experts-669458335456-ap-south-1-an
MORNORK_S3_PREFIX=mornork/models
MORNORK_MODEL_CACHE_DIR=artifacts/model-cache
MORNORK_UPLOAD_TRAINED_MODELS=true
MORNORK_LOAD_MODELS_FROM_S3=true
AWS_DEFAULT_REGION=ap-south-1
AWS_PROFILE=default
